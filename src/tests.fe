// Metered tabs

#[test]
fn metered_tab_charges_signed_totals() uses (evm: mut Evm) {
    let w = world()
    let id = open(w, capture_by: NEVER, metered: true)
    settle(w, id, total: 12)
    settle(w, id, total: 40)
    assert!(balance(w, account: evm.address()) == 40)
    assert!(held(w, id) == 60)
    close(w, id)
    assert!(balance(w, account: w.wallet) == 60)
    assert_books(w, id)
}

// cast sig "Metered()"
#[test(should_revert, selector = 0x324e8145)]
fn metered_tab_rejects_unsigned_charges() uses (evm: mut Evm) {
    let w = world()
    let id = open(w, capture_by: NEVER, metered: true)
    charge(w, id, amount: 1)
}

// cast sig "StaleReceipt()"
#[test(should_revert, selector = 0x07ab6ca1)]
fn an_old_receipt_cannot_be_replayed() uses (evm: mut Evm) {
    let w = world()
    let id = open(w, capture_by: NEVER, metered: true)
    settle(w, id, total: 30)
    settle(w, id, total: 30)
}

// The merchant submits a total the payer never signed.
// cast sig "BadSignature()"
#[test(should_revert, selector = 0x5cd5d233)]
fn an_unsigned_receipt_reverts() uses (evm: mut Evm) {
    let w = world()
    let id = open(w, capture_by: NEVER, metered: true)
    evm.call(
        addr: w.pacioli,
        gas: GAS,
        value: Wei::zero(),
        message: PacioliMsg::Settle { id, total: 50, signature: Bytes::empty() },
    )
}

// cast sig "ExceedsHeld()"
#[test(should_revert, selector = 0x4d0b7d02)]
fn a_receipt_above_the_limit_reverts() uses (evm: mut Evm) {
    let w = world()
    let id = open(w, capture_by: NEVER, metered: true)
    settle(w, id, total: LIMIT + 1)
}

// cast sig "NotMetered()"
#[test(should_revert, selector = 0xcb514bab)]
fn receipts_only_settle_metered_tabs() uses (evm: mut Evm) {
    let w = world()
    let id = open(w, capture_by: NEVER, metered: false)
    settle(w, id, total: 10)
}

// ---------------------------------------------------------------------------
// Invariants
//
// Random sequences of charges, receipts and refunds, with the books checked
// after every step. The seed is fixed, so a failure replays exactly.

const STEPS: u256 = 24

#[test]
fn books_balance_through_random_charges_and_refunds() uses (evm: mut Evm) {
    let w = world()
    let id = open(w, capture_by: NEVER, metered: false)
    var rng = KeccakRng::seeded(0xbeef)
    var step: u256 = 0
    while step < STEPS {
        let (_, held, charged, _, refunded) = accounts(w, id)
        if rng.uniform(3) < 2 {
            if held > 0 {
                charge(w, id, amount: 1 + rng.uniform(held))
            }
        } else if charged > refunded {
            refund(w, id, amount: 1 + rng.uniform(charged - refunded))
        }
        assert_books(w, id)
        step += 1
    }
    if held(w, id) > 0 {
        close(w, id)
    }
    assert_books(w, id)
    assert!(balance(w, account: w.pacioli) == 0)
}

#[test]
fn books_balance_through_random_receipts() uses (evm: mut Evm) {
    let w = world()
    let id = open(w, capture_by: NEVER, metered: true)
    var rng = KeccakRng::seeded(0xfeed)
    var step: u256 = 0
    while step < STEPS {
        let (_, held, charged, _, _) = accounts(w, id)
        if held > 0 {
            settle(w, id, total: charged + 1 + rng.uniform(held))
        }
        assert_books(w, id)
        step += 1
    }
    assert!(accounts(w, id).2 == LIMIT)
    assert_books(w, id)
}

// ---------------------------------------------------------------------------
// Typed-data vectors
//
// viem computes these from the typed data in `web/src/pacioli.ts`
// (`node web/scripts/vectors.ts`), independent of this implementation; Anvil
// account 0 signs. `cast wallet sign --data` gives the same signature, and
// `cast keccak` over `cast abi-encode` the same struct hash.
//
//   domain:  Pacioli, version 1, chain 31337, verifying contract 0xdddd...dddd
//   message: payer anvil 0, merchant anvil 1, token 0xcccc...cccc,
//            limit 100, openBy 2000000000, captureBy 2000003600,
//            metered true, nonce 1

const PAYER: u256 = 0xf39fd6e51aad88f6f4ce6ab8827279cfffb92266
const VECTOR_STRUCT_HASH: u256 = 0x715892ffed22337f774afdc509341d326e04379a70d56674daf2c10d44dce571
const VECTOR_DIGEST: u256 = 0x498fc170b5e91c841f4633a53cefc3d140448b1f9f002f9599251b212710a4d6
const VECTOR_SIG_R: u256 = 0x79642722dfdfc835193b6f211fcf28953c695a75ede3d1a64bcebbd1d18b813e
const VECTOR_SIG_S: u256 = 0x2637d32f4ac7084e05daddd05e73191da8249b37976aefec345acddc0ef0acde
const VECTOR_SIG_V: u8 = 27
const VECTOR_RECEIPT_DIGEST: u256 = 0xea154639de0e1e4ab8e2951058db6dc6155d43f72e6480e3c79e24494b790f1a
const VECTOR_PERMIT2_DIGEST: u256 = 0x857d0889655df0b1ee1e29a8391f9b5f500d8c0fce8fb3b0718ee0a6811cb5c7

fn vector_auth() -> Authorization {
    Authorization {
        payer: Address::new(PAYER),
        merchant: Address::new(0x70997970c51812dc3a010c7d01b50e0d17dc79c8),
        token: Address::new(0xcccccccccccccccccccccccccccccccccccccccc),
        limit: 100,
        open_by: Timestamp::from_seconds(2000000000),
        capture_by: Timestamp::from_seconds(2000003600),
        metered: true,
        nonce: 1,
    }
}

fn vector_separator() -> u256 {
    eip712::domain_separator(
        name_hash: NAME_HASH,
        version_hash: VERSION_HASH,
        chain_id: 31337,
        verifying_contract: Address::new(0xdddddddddddddddddddddddddddddddddddddddd),
    )
}

#[test]
fn authorization_matches_wallet_typed_data() {
    let auth = vector_auth()
    assert!(auth.hash() == VECTOR_STRUCT_HASH)
    let digest = eip712::digest(
        domain_separator: vector_separator(),
        struct_hash: auth.hash(),
    )
    assert!(digest == VECTOR_DIGEST)

    let sig = MemBuffer::new(65)
    unsafe {
        store_word(ptr: sig.ptr(), value: VECTOR_SIG_R)
        store_word(ptr: ptr::offset_bytes(sig.ptr(), 32), value: VECTOR_SIG_S)
        *ptr::offset_bytes(sig.ptr(), 64) = VECTOR_SIG_V
    }
    match signature::recover(digest, sig.span()) {
        Option::Some(signer) => assert!(signer.word() == PAYER),
        Option::None => assert!(false),
    }
}

#[test]
fn receipt_matches_wallet_typed_data() {
    let id = eip712::digest(
        domain_separator: vector_separator(),
        struct_hash: vector_auth().hash(),
    )
    let digest = eip712::digest(
        domain_separator: vector_separator(),
        struct_hash: receipt_hash(id, total: 42),
    )
    assert!(digest == VECTOR_RECEIPT_DIGEST)
}

// Permit2 at its canonical address on chain 31337, spender 0xdddd...dddd.
#[test]
fn permit2_digest_matches_permit2_typed_data() {
    let digest = permit2_digest(
        chain_id: 31337,
        permit2: Address::new(0x000000000022d473030f116ddee9f6b43ac78ba3),
        spender: Address::new(0xdddddddddddddddddddddddddddddddddddddddd),
        auth: vector_auth(),
    )
    assert!(digest == VECTOR_PERMIT2_DIGEST)
}
