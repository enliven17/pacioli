// Run the tests with `fe test`.
//
// The test account acts as the merchant. The payer is a contract wallet that
// approves digests on chain (ERC-1271), so no private key is needed. The
// same wallet signs for all three funding sources and for receipts.

use core::abi::store_word
use core::option::Option
use core::ptr::{self, MemBuffer}
use ingot::{PacioliMsg, Pacioli}
use ingot::authorization::{Authorization, NAME_HASH, VERSION_HASH, receipt_hash}
use ingot::demo_token::{DemoToken, TokenMsg, receive_hash}
use ingot::funding::{Permit2Msg, permit2_digest}
use std::abi::Bytes32
use std::evm::{StorageMap, eip712, signature}
use std::evm::random::{KeccakRng, Rng}

const GAS: u256 = 5_000_000
const LIMIT: u256 = 100
const MAGIC_WORD: u256 = 0x1626ba7e << 224
const NEVER: u256 = 0xffffffffffff

msg WalletMsg {
    #[selector = sol("isValidSignature(bytes32,bytes)")]
    IsValidSignature { hash: Bytes32, signature: Bytes } -> u256,
    #[selector = sol("sign(uint256)")]
    Sign { digest: u256 },
    #[selector = sol("approve(address,address,uint256)")]
    Approve { token: Address, spender: Address, amount: u256 },
}

/// A payer wallet that accepts the digests it was told to sign.
pub contract Wallet uses (call: mut Call) {
    mut signed: StorageMap<u256, bool>,

    recv WalletMsg {
        IsValidSignature { hash, signature } -> u256
        uses (signed)
        {
            if signed.get(key: hash.val) {
                return MAGIC_WORD
            }
            let rejected: u256 = 0
            rejected
        }

        Sign { digest } uses (mut signed) {
            signed.set(key: digest, value: true)
        }

        Approve { token, spender, amount } uses (mut call) {
            let ok: bool = call
                .call(
                    addr: token,
                    gas: GAS,
                    value: Wei::zero(),
                    message: TokenMsg::Approve { spender, amount },
                )
            assert!(ok)
        }
    }
}

msg StrangerMsg {
    #[selector = sol("charge(address,uint256,uint256)")]
    Charge { pacioli: Address, id: u256, amount: u256 },
}

/// Any account other than the merchant.
pub contract Stranger uses (call: mut Call) {
    recv StrangerMsg {
        Charge { pacioli, id, amount } uses (mut call) {
            call.call(
                addr: pacioli,
                gas: GAS,
                value: Wei::zero(),
                message: PacioliMsg::Charge { id, amount },
            )
        }
    }
}

msg HollowMsg {
    #[selector = sol("balanceOf(address)")]
    BalanceOf { account: Address } -> u256,
    #[selector = sol("transferFrom(address,address,uint256)")]
    TransferFrom { from: Address, to: Address, amount: u256 } -> bool,
}

/// A token that reports success without moving anything.
pub contract Hollow {
    recv HollowMsg {
        BalanceOf { account } -> u256 {
            let _ = account
            let none: u256 = 0
            none
        }

        TransferFrom { from, to, amount } -> bool {
            let _ = (from, to, amount)
            true
        }
    }
}

#[error]
pub struct PermitExpired {}

#[error]
pub struct NonceUsed {}

#[error]
pub struct PermitSignature {}

/// Permit2's `permitWitnessTransferFrom`, enough of it to check that
/// Pacioli sends what Permit2 expects: the digest is `permit2_digest`, whose
/// encoding the vector test below pins against Permit2's typed data.
pub contract MockPermit2 uses (ctx: Ctx, call: mut Call) {
    mut used: StorageMap<(Address, u256), bool>,

    recv Permit2Msg {
        PermitWitnessTransferFrom { permit, details, owner, witness, witness_type, signature }
        uses (ctx, mut call, mut used)
        {
            let _ = witness_type
            if ctx.timestamp().as_seconds() > permit.deadline {
                revert_error(PermitExpired {})
            }
            if used.get(key: (owner, permit.nonce)) {
                revert_error(NonceUsed {})
            }
            let auth_from_witness = witness.val
            let digest = permit2_witness_digest(
                chain_id: ctx.chainid(),
                permit2: ctx.address(),
                spender: ctx.caller(),
                token: permit.permitted.token,
                amount: permit.permitted.amount,
                nonce: permit.nonce,
                deadline: permit.deadline,
                witness: auth_from_witness,
            )
            if !signature::is_valid_signature_now(owner, digest, signature: signature.span()) {
                revert_error(PermitSignature {})
            }
            used.set(key: (owner, permit.nonce), value: true)
            let ok: bool = call
                .call(
                    addr: permit.permitted.token,
                    gas: GAS,
                    value: Wei::zero(),
                    message: TokenMsg::TransferFrom {
                        from: owner,
                        to: details.to,
                        amount: details.requested_amount,
                    },
                )
            assert!(ok)
        }
    }
}

/// `permit2_digest` from raw fields, for the mock, which sees only the
/// witness hash and not the authorization behind it.
fn permit2_witness_digest(
    chain_id: u256,
    permit2: Address,
    spender: Address,
    token: Address,
    amount: u256,
    nonce: u256,
    deadline: u256,
    witness: u256,
) -> u256 {
    use std::evm::crypto::keccak_words
    use ingot::funding::{
        PERMIT2_DOMAIN_TYPEHASH,
        PERMIT2_NAME_HASH,
        PERMIT_WITNESS_TYPEHASH,
        TOKEN_PERMISSIONS_TYPEHASH,
    }
    let separator = keccak_words(
        [PERMIT2_DOMAIN_TYPEHASH, PERMIT2_NAME_HASH, chain_id, permit2.word()],
    )
    let permitted = keccak_words([TOKEN_PERMISSIONS_TYPEHASH, token.word(), amount])
    let struct_hash = keccak_words(
        [PERMIT_WITNESS_TYPEHASH, permitted, spender.word(), nonce, deadline, witness],
    )
    eip712::digest(domain_separator: separator, struct_hash)
}

struct World { token: Address, pacioli: Address, wallet: Address, permit2: Address }

impl Copy for World {}

/// Deploys everything and funds the wallet with `LIMIT` tokens.
fn world() -> World uses (evm: mut Evm) {
    let token = evm.create2<DemoToken>(value: Wei::zero(), args: (), salt: 0)
    let permit2 = evm.create2<MockPermit2>(value: Wei::zero(), args: (), salt: 0)
    let pacioli = evm.create2<Pacioli>(value: Wei::zero(), args: (permit2,), salt: 0)
    let wallet = evm.create2<Wallet>(value: Wei::zero(), args: (), salt: 0)
    evm.call(
        addr: token,
        gas: GAS,
        value: Wei::zero(),
        message: TokenMsg::Mint { to: wallet, amount: LIMIT },
    )
    World { token, pacioli, wallet, permit2 }
}

fn approve(w: World, spender: Address, amount: u256) uses (evm: mut Evm) {
    evm.call(
        addr: w.wallet,
        gas: GAS,
        value: Wei::zero(),
        message: WalletMsg::Approve { token: w.token, spender, amount },
    )
}

fn sign(w: World, digest: u256) uses (evm: mut Evm) {
    evm.call(
        addr: w.wallet,
        gas: GAS,
        value: Wei::zero(),
        message: WalletMsg::Sign { digest },
    )
}

fn terms(w: World, limit: u256, capture_by: u256, metered: bool) -> Authorization
uses (evm: Evm)
{
    Authorization {
        payer: w.wallet,
        merchant: evm.address(),
        token: w.token,
        limit,
        open_by: Timestamp::from_seconds(NEVER),
        capture_by: Timestamp::from_seconds(capture_by),
        metered,
        nonce: 1,
    }
}

fn digest(w: World, auth: Authorization) -> u256 uses (evm: mut Evm) {
    evm.call(
        addr: w.pacioli,
        gas: GAS,
        value: Wei::zero(),
        message: PacioliMsg::Digest { auth },
    )
}

/// Approves the escrow, has the wallet sign `signed`, and opens `auth`.
fn open_signed(w: World, signed: Authorization, auth: Authorization) -> u256
uses (evm: mut Evm)
{
    approve(w, spender: w.pacioli, amount: auth.limit)
    sign(w, digest: digest(w, auth: signed))
    evm.call(
        addr: w.pacioli,
        gas: GAS,
        value: Wei::zero(),
        message: PacioliMsg::Open { auth, signature: Bytes::empty() },
    )
}

fn open(w: World, capture_by: u256, metered: bool) -> u256 uses (evm: mut Evm) {
    let auth = terms(w, limit: LIMIT, capture_by, metered)
    open_signed(w, signed: auth, auth)
}

fn balance(w: World, account: Address) -> u256 uses (evm: mut Evm) {
    evm.call(
        addr: w.token,
        gas: GAS,
        value: Wei::zero(),
        message: TokenMsg::BalanceOf { account },
    )
}

fn accounts(w: World, id: u256) -> (u256, u256, u256, u256, u256)
uses (evm: mut Evm)
{
    evm.call(
        addr: w.pacioli,
        gas: GAS,
        value: Wei::zero(),
        message: PacioliMsg::Accounts { id },
    )
}

fn held(w: World, id: u256) -> u256 uses (evm: mut Evm) {
    accounts(w, id).1
}

fn charge(w: World, id: u256, amount: u256) uses (evm: mut Evm) {
    evm.call(
        addr: w.pacioli,
        gas: GAS,
        value: Wei::zero(),
        message: PacioliMsg::Charge { id, amount },
    )
}

fn close(w: World, id: u256) uses (evm: mut Evm) {
    evm.call(
        addr: w.pacioli,
        gas: GAS,
        value: Wei::zero(),
        message: PacioliMsg::Close { id },
    )
}

fn refund(w: World, id: u256, amount: u256) uses (evm: mut Evm) {
    let _: bool = evm
        .call(
            addr: w.token,
            gas: GAS,
            value: Wei::zero(),
            message: TokenMsg::Approve { spender: w.pacioli, amount },
        )
    evm.call(
        addr: w.pacioli,
        gas: GAS,
        value: Wei::zero(),
        message: PacioliMsg::Refund { id, amount },
    )
}

/// Has the wallet sign a receipt for `total` and submits it.
fn settle(w: World, id: u256, total: u256) uses (evm: mut Evm) {
    let digest: u256 = evm
        .call(
            addr: w.pacioli,
            gas: GAS,
            value: Wei::zero(),
            message: PacioliMsg::ReceiptDigest { id, total },
        )
    sign(w, digest)
    evm.call(
        addr: w.pacioli,
        gas: GAS,
        value: Wei::zero(),
        message: PacioliMsg::Settle { id, total, signature: Bytes::empty() },
    )
}

/// The double-entry rule, and the token balances that must match it.
fn assert_books(w: World, id: u256) uses (evm: mut Evm) {
    let (limit, held, charged, released, refunded) = accounts(w, id)
    assert!(held + charged + released == limit)
    assert!(refunded <= charged)
    assert!(balance(w, account: w.pacioli) == held)
    assert!(
        balance(w, account: w.wallet) + limit == LIMIT + released + refunded,
    )
    assert!(balance(w, account: evm.address()) == charged - refunded)
}

// ---------------------------------------------------------------------------
// Funding sources

#[test]
fn open_moves_the_limit_into_escrow() uses (evm: mut Evm) {
    let w = world()
    let id = open(w, capture_by: NEVER, metered: false)
    assert!(held(w, id) == LIMIT)
    assert!(balance(w, account: w.pacioli) == LIMIT)
    assert!(balance(w, account: w.wallet) == 0)

    let t: (Address, Address, Address, Timestamp, bool) = evm
        .call(
            addr: w.pacioli,
            gas: GAS,
            value: Wei::zero(),
            message: PacioliMsg::TermsOf { id },
        )
    assert!(t.0 == w.wallet)
    assert!(t.1 == evm.address())
    assert!(t.2 == w.token)
    assert!(t.3 == Timestamp::from_seconds(NEVER))
    assert!(!t.4)
    assert_books(w, id)
}

#[test]
fn open_with_erc3009_needs_no_approval() uses (evm: mut Evm) {
    let w = world()
    let auth = terms(w, limit: LIMIT, capture_by: NEVER, metered: false)
    let id = digest(w, auth)
    let separator: u256 = evm
        .call(
            addr: w.token,
            gas: GAS,
            value: Wei::zero(),
            message: TokenMsg::DomainSeparator {},
        )
    sign(
        w,
        digest: eip712::digest(
            domain_separator: separator,
            struct_hash: receive_hash(
                from: w.wallet,
                to: w.pacioli,
                value: LIMIT,
                valid_after: 0,
                valid_before: NEVER,
                nonce: id,
            ),
        ),
    )
    let opened: u256 = evm
        .call(
            addr: w.pacioli,
            gas: GAS,
            value: Wei::zero(),
            message: PacioliMsg::OpenWithErc3009 { auth, signature: Bytes::empty() },
        )
    assert!(opened == id)
    assert!(held(w, id) == LIMIT)
    let spent: bool = evm
        .call(
            addr: w.token,
            gas: GAS,
            value: Wei::zero(),
            message: TokenMsg::AuthorizationState {
                authorizer: w.wallet,
                nonce: Bytes32 { val: id },
            },
        )
    assert!(spent)
    assert_books(w, id)
}

#[test]
fn open_with_permit2_witness() uses (evm: mut Evm) {
    let w = world()
    approve(w, spender: w.permit2, amount: LIMIT)
    let auth = terms(w, limit: LIMIT, capture_by: NEVER, metered: true)
    sign(
        w,
        digest: permit2_digest(
            chain_id: evm.chainid(),
            permit2: w.permit2,
            spender: w.pacioli,
            auth,
        ),
    )
    let id: u256 = evm
        .call(
            addr: w.pacioli,
            gas: GAS,
            value: Wei::zero(),
            message: PacioliMsg::OpenWithPermit2 { auth, signature: Bytes::empty() },
        )
    assert!(id == digest(w, auth))
    assert!(held(w, id) == LIMIT)
    assert_books(w, id)
}

// The wallet signed a Permit2 transfer for different terms: the witness no
// longer matches, so Permit2 rejects it.
// cast sig "PermitSignature()"
#[test(should_revert, selector = 0x50631db7)]
fn permit2_rejects_changed_terms() uses (evm: mut Evm) {
    let w = world()
    approve(w, spender: w.permit2, amount: LIMIT)
    let signed = terms(w, limit: LIMIT, capture_by: NEVER, metered: true)
    sign(
        w,
        digest: permit2_digest(
            chain_id: evm.chainid(),
            permit2: w.permit2,
            spender: w.pacioli,
            auth: signed,
        ),
    )
    let auth = terms(w, limit: LIMIT, capture_by: NEVER, metered: false)
    let _: u256 = evm
        .call(
            addr: w.pacioli,
            gas: GAS,
            value: Wei::zero(),
            message: PacioliMsg::OpenWithPermit2 { auth, signature: Bytes::empty() },
        )
}

// The token reports success but moves nothing.
// cast sig "ShortFunding()"
#[test(should_revert, selector = 0x4a8f0e82)]
fn hollow_funding_reverts() uses (evm: mut Evm) {
    let w = world()
    let hollow = evm.create2<Hollow>(value: Wei::zero(), args: (), salt: 0)
    let auth = Authorization {
        payer: w.wallet,
        merchant: evm.address(),
        token: hollow,
        limit: LIMIT,
        open_by: Timestamp::from_seconds(NEVER),
        capture_by: Timestamp::from_seconds(NEVER),
        metered: false,
        nonce: 1,
    }
    sign(w, digest: digest(w, auth))
    let _: u256 = evm
        .call(
            addr: w.pacioli,
            gas: GAS,
            value: Wei::zero(),
            message: PacioliMsg::Open { auth, signature: Bytes::empty() },
        )
}

// ---------------------------------------------------------------------------
// Unmetered tabs

#[test]
fn charge_in_parts_then_close() uses (evm: mut Evm) {
    let w = world()
    let id = open(w, capture_by: NEVER, metered: false)
    charge(w, id, amount: 30)
    charge(w, id, amount: 20)
    assert!(balance(w, account: evm.address()) == 50)
    assert!(held(w, id) == 50)
    close(w, id)
    assert!(held(w, id) == 0)
    assert!(balance(w, account: w.wallet) == 50)
    assert_books(w, id)
}

#[test]
fn refund_returns_charged_funds() uses (evm: mut Evm) {
    let w = world()
    let id = open(w, capture_by: NEVER, metered: false)
    charge(w, id, amount: 60)
    refund(w, id, amount: 25)
    assert!(balance(w, account: w.wallet) == 25)
    assert!(balance(w, account: evm.address()) == 35)
    assert!(accounts(w, id).4 == 25)
    assert_books(w, id)
}

#[test]
fn reclaim_after_the_capture_window() uses (evm: mut Evm) {
    let w = world()
    let id = open(w, capture_by: 0, metered: false)
    evm.call(
        addr: w.pacioli,
        gas: GAS,
        value: Wei::zero(),
        message: PacioliMsg::Reclaim { id },
    )
    assert!(balance(w, account: w.wallet) == LIMIT)
    assert!(accounts(w, id).3 == LIMIT)
    assert_books(w, id)
}

// cast sig "NotExpired()"
#[test(should_revert, selector = 0xd0404f85)]
fn reclaim_inside_the_capture_window_reverts() uses (evm: mut Evm) {
    let w = world()
    let id = open(w, capture_by: NEVER, metered: false)
    evm.call(
        addr: w.pacioli,
        gas: GAS,
        value: Wei::zero(),
        message: PacioliMsg::Reclaim { id },
    )
}

// cast sig "Expired()"
#[test(should_revert, selector = 0x203d82d8)]
fn charge_after_the_capture_window_reverts() uses (evm: mut Evm) {
    let w = world()
    let id = open(w, capture_by: 0, metered: false)
    charge(w, id, amount: 1)
}

// cast sig "ExceedsHeld()"
#[test(should_revert, selector = 0x4d0b7d02)]
fn charge_above_the_held_amount_reverts() uses (evm: mut Evm) {
    let w = world()
    let id = open(w, capture_by: NEVER, metered: false)
    charge(w, id, amount: 70)
    charge(w, id, amount: 31)
}

// cast sig "AlreadyOpen()"
#[test(should_revert, selector = 0x965f8d94)]
fn opening_the_same_authorization_twice_reverts() uses (evm: mut Evm) {
    let w = world()
    let _ = open(w, capture_by: NEVER, metered: false)
    let _ = open(w, capture_by: NEVER, metered: false)
}

// The wallet signed for 50, the merchant asks for 100.
// cast sig "BadSignature()"
#[test(should_revert, selector = 0x5cd5d233)]
fn opening_with_changed_terms_reverts() uses (evm: mut Evm) {
    let w = world()
    let auth = terms(w, limit: LIMIT, capture_by: NEVER, metered: false)
    let signed = terms(w, limit: 50, capture_by: NEVER, metered: false)
    let _ = open_signed(w, signed, auth)
}

// cast sig "NotMerchant()"
#[test(should_revert, selector = 0x3b6405f4)]
fn stranger_cannot_charge() uses (evm: mut Evm) {
    let w = world()
    let id = open(w, capture_by: NEVER, metered: false)
    let stranger = evm.create2<Stranger>(value: Wei::zero(), args: (), salt: 0)
    evm.call(
        addr: stranger,
        gas: GAS,
        value: Wei::zero(),
        message: StrangerMsg::Charge { pacioli: w.pacioli, id, amount: 1 },
    )
}

// cast sig "ExceedsCharged()"
#[test(should_revert, selector = 0xaddddaa3)]
fn refund_above_the_charged_amount_reverts() uses (evm: mut Evm) {
    let w = world()
    let id = open(w, capture_by: NEVER, metered: false)
    charge(w, id, amount: 10)
    refund(w, id, amount: 11)
}

